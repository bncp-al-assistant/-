    "additionalRequest": {
      "type": "textarea",
      "label": "추가 요청사항",
      "required": false,
      "placeholder": "기본 제공 품목 외 추가로 필요한 사항을 입력하세요 (예: 노래방 기기 사용, 음료 추가 등)"
    },
    "remarks": {
      "type": "text",
      "label": "비고",
      "required": false
    }
  },

